# Microsoft 365 / Azure Entra ID OneDrive Integration for IXG Wall of Fame
# Set these environment variables in your Vercel Project Dashboard (Settings > Environment Variables)

# 1. Influence Exchange Group Microsoft 365 Tenant ID (Pre-configured)
MICROSOFT_TENANT_ID=65d4e379-8f09-428d-9848-02c028d6e44c

# 2. Azure App Registration Client ID (Application ID from portal.azure.com)
MICROSOFT_CLIENT_ID=your-client-id-here

# 3. Azure App Registration Client Secret Value
MICROSOFT_CLIENT_SECRET=your-client-secret-value-here

# 4. OneDrive User Email owning the "All Events" folder
ONEDRIVE_USER_EMAIL=evaan_fernandes@influenceexchangegroup.com

# 5. OneDrive Folder Path to sync (Default: All Events)
ONEDRIVE_FOLDER_PATH=All Events
